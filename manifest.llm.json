{
  "manifest_version": 3,
  "name": "AssisT LLM: Adaptive Accessibility + Local AI",
  "version": "0.1.0",
  "description": "Universal accessibility extension with local LLM integration for enhanced Text-to-Speech, intelligent summarization, and adaptive features",
  "author": "AssisT Development Team",

  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "contextMenus",
    "nativeMessaging"
  ],

  "host_permissions": [
    "<all_urls>",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],

  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/content-simple.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],

  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "AssisT LLM - Adaptive Accessibility + AI"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/components/*.js",
        "src/ui/styles/*.css",
        "public/assets/*",
        "src/adapters/canvas-adapter.js",
        "src/adapters/moodle-adapter.js",
        "src/adapters/google-classroom-adapter.js",
        "src/engines/stt/stt-controller.js",
        "src/ui/components/microphone-button.js",
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "src/pages/discovery/*",
        "src/pages/demo/*",
        "src/features/llm/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*"
  }
}
