# Chrome Web Store Publish API credentials (only needed to run scripts/cws-publish.js).
# Copy this file to .env (gitignored) and fill in your values.
#
# Where the values come from:
# - CWS_EXTENSION_ID and CWS_PUBLISHER_ID: the Chrome Web Store developer dashboard
#   (the publisher ID is under Publisher > Settings; it is not the extension ID).
# - CWS_CLIENT_ID and CWS_CLIENT_SECRET: an OAuth client (type Web application) created in a
#   Google Cloud project that has the Chrome Web Store API enabled.
# - CWS_REFRESH_TOKEN: a refresh token for the scope https://www.googleapis.com/auth/chromewebstore,
#   obtained for that client with the Google OAuth 2.0 Playground.

CWS_EXTENSION_ID=your_extension_id_here
CWS_PUBLISHER_ID=your_publisher_id_here
CWS_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
CWS_CLIENT_SECRET=your_client_secret_here
CWS_REFRESH_TOKEN=your_refresh_token_here
