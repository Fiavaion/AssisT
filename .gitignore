# Dependencies
node_modules/

# Institution signing: the PRIVATE key must never be committed (the public key is bundled in src).
# The real private key lives outside this repo; these patterns are defence-in-depth in case
# `scripts/issue-institution-key.mjs genkey` is ever pointed at a repo-relative path.
secrets/
*private-key*.jwk

# Build output (Chrome loads the extension from .vite/)
.vite/
dist/
build/
*.crx
*.zip
*.extensionpkg

# Test coverage and results
coverage/
.nyc_output/
test-results/
playwright-report/

# Environment variables
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
nul

# Temporary files
tmp/
temp/
*.tmp

# Only these docs folders are published
docs/*
!docs/quality/
!docs/adr/

# CSL style and locale cache for scripts/csl-crosscheck.mjs (CC BY-SA files, never committed)
.cache/csl/

# WebLLM model libraries, downloaded and checked at build time (scripts/webllm-model-libs.js,
# ADR 0010). Third-party compiled code, 45 MB per library version, never committed.
.cache/webllm-libs/
