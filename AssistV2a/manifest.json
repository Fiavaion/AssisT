{
  "manifest_version": 3,
  "name": "AssisT: Adaptive Accessibility Tool",
  "version": "0.1.0",
  "description": "Universal accessibility extension with Text-to-Speech, customizable highlighting, and adaptive features for all websites",
  "author": "AssisT Development Team",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content-simple.js-loader-LLyaamDo.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "AssisT - Adaptive Accessibility"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "src/ui/components/*.js",
        "src/ui/styles/*.css",
        "public/assets/*",
        "src/adapters/canvas-adapter.js",
        "src/adapters/moodle-adapter.js",
        "src/adapters/google-classroom-adapter.js",
        "src/engines/stt/stt-controller.js",
        "src/ui/components/microphone-button.js",
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "src/pages/discovery/*",
        "src/pages/demo/*",
        "assets/storage-adapter-_vjWlDz9.js",
        "assets/storage-adapter-_vjWlDz9.js.map",
        "assets/index-BkqOQ2dB.js",
        "assets/index-BkqOQ2dB.js.map",
        "assets/pdf-DSyF5veC.js",
        "assets/pdf-DSyF5veC.js.map",
        "assets/index-WSgnozFX.js",
        "assets/index-WSgnozFX.js.map",
        "assets/content-simple.js-Yjbu1eFh.js",
        "assets/content-simple.js-Yjbu1eFh.js.map"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
