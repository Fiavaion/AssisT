{
  "name": "assist-adaptive-edtech",
  "version": "0.1.0",
  "description": "Neuro-Adaptive Layer for Canvas VLE - TTS/STT personalization for neurodivergent students",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "npm run build && pa11y --standard WCAG2AA ./.vite/src/popup/popup.html",
    "test:a11y:ci": "pa11y-ci",
    "verify:testids": "node tests/utils/verify-testids.cjs",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "build": "vite build && node scripts/inject-popup-scripts.js",
    "dev": "vite build --watch",
    "postbuild": "node scripts/inject-popup-scripts.js",
    "prepare": "husky",
    "switch:assist": "node scripts/generate-manifest.js assist && npm run build && echo Switched to AssisT - reload extension from .vite/",
    "switch:llm": "node scripts/generate-manifest.js llm && npm run build && echo Switched to AssisT LLM - reload extension from .vite/",
    "docs:build": "node scripts/build-docs.cjs",
    "docs:watch": "node scripts/build-docs.cjs --watch"
  },
  "keywords": [
    "accessibility",
    "edtech",
    "tts",
    "stt",
    "neurodiversity",
    "dyslexia",
    "dysgraphia",
    "wcag",
    "wai-adapt"
  ],
  "author": "AssisT Development Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@crxjs/vite-plugin": "^2.2.1",
    "@playwright/test": "^1.47.0",
    "@types/chrome": "^0.0.270",
    "babel-jest": "^30.2.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.3.3",
    "sharp": "^0.34.5",
    "vite": "^7.1.12"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "citeproc": "^2.4.63",
    "compromise": "^14.14.4",
    "crypto-js": "^4.2.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "dexie": "^3.2.0",
    "dompurify": "^3.3.1",
    "open-graph-scraper": "^6.4.0",
    "pdfjs-dist": "^5.4.394",
    "sortablejs": "^1.15.6",
    "tesseract.js": "^5.0.0"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{html,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
