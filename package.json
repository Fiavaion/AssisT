{
  "name": "assist-adaptive-edtech",
  "version": "0.1.0",
  "description": "Neuro-Adaptive Layer for Canvas VLE - TTS/STT personalization for neurodivergent students",
  "type": "module",
  "scripts": {
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:a11y": "npm run build && pa11y --standard WCAG2AA ./Output/src/popup/popup.html",
    "test:a11y:ci": "pa11y-ci",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "build": "node scripts/build-extension.js",
    "dev": "node scripts/dev-server.js",
    "prepare": "husky"
  },
  "keywords": [
    "accessibility",
    "edtech",
    "tts",
    "stt",
    "neurodiversity",
    "dyslexia",
    "dysgraphia",
    "wcag",
    "wai-adapt"
  ],
  "author": "AssisT Development Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@playwright/test": "^1.47.0",
    "@types/chrome": "^0.0.270",
    "babel-jest": "^30.2.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.2.4",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "compromise": "^14.14.4"
  },
  "lint-staged": {
    "src/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{html,css}": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
