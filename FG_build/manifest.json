{
  "manifest_version": 3,
  "name": "@NCAD",
  "version": "0.1.0",
  "description": "NCAD accessibility extension with Text-to-Speech, customizable highlighting, and adaptive features for Canvas VLE",
  "author": "AssisT Development Team",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "contextMenus",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://api.anthropic.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ollama_cors_rules",
        "enabled": true,
        "path": "rules/ollama-cors.json"
      }
    ]
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content-simple.js-loader-CQFOHnS_.js"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "@NCAD - Adaptive Accessibility"
  },
  "web_accessible_resources": [
    {
      "matches": [
        "<all_urls>"
      ],
      "resources": [
        "src/ui/components/*.js",
        "src/ui/styles/*.css",
        "public/assets/*",
        "src/adapters/canvas-adapter.js",
        "src/adapters/moodle-adapter.js",
        "src/adapters/google-classroom-adapter.js",
        "src/engines/stt/*.js",
        "src/ui/components/microphone-button.js",
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "src/pages/discovery/*",
        "src/pages/demo/*",
        "assets/storage-adapter-CU703aa-.js",
        "assets/storage-adapter-CU703aa-.js.map",
        "assets/index-C7Jv7g1J.js",
        "assets/index-C7Jv7g1J.js.map",
        "assets/pdf-DSyF5veC.js",
        "assets/pdf-DSyF5veC.js.map",
        "assets/index-WSgnozFX.js",
        "assets/index-WSgnozFX.js.map",
        "assets/_commonjs-dynamic-modules-C0OTmW6W.js",
        "assets/_commonjs-dynamic-modules-C0OTmW6W.js.map",
        "assets/content-simple.js-CXBbmrOh.js",
        "assets/content-simple.js-CXBbmrOh.js.map"
      ],
      "use_dynamic_url": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
