{
  "manifest_version": 3,
  "version": "1.0.0",
  "author": "AssisT Development Team",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.com/*",
        "*://*.moodle.org/*",
        "*://*.moodlecloud.com/*",
        "*://classroom.google.com/*",
        "*://docs.google.com/*"
      ],
      "js": [
        "src/content/content-simple.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "AssisT - Augmentative Learning"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "node_modules/tesseract.js/dist/worker.min.js",
        "node_modules/tesseract.js-core/tesseract-core-simd-lstm.wasm.js",
        "node_modules/tesseract.js-core/tesseract-core-lstm.wasm.js",
        "node_modules/@tesseract.js-data/eng/4.0.0_best_int/eng.traineddata.gz",
        "assets/*.js",
        "assets/*.css",
        "src/assets/fonts/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.anthropic.com https://api.openai.com https://generativelanguage.googleapis.com https://api.perplexity.ai https://api.mymemory.translated.net https://api.crossref.org https://api.semanticscholar.org https://api.dictionaryapi.dev https://cdn.jsdelivr.net http://localhost:11434 http://127.0.0.1:11434 https://*.huggingface.co https://huggingface.co https://hf.co https://*.hf.co https://*.xethub.hf.co; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "name": "AssisT: Adaptive Augmentative Tool",
  "description": "Adaptive learning tools with Text-to-Speech, AI assistance, and accessibility features for all learners",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.canvas.com/*",
    "*://*.moodle.org/*",
    "*://*.moodlecloud.com/*",
    "*://classroom.google.com/*",
    "*://docs.google.com/*",
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://*.xethub.hf.co/*"
  ],
  "optional_host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "<all_urls>",
    "https://api.semanticscholar.org/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.perplexity.ai/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.mymemory.translated.net/*",
    "https://api.crossref.org/*",
    "https://cdn.jsdelivr.net/*"
  ],
  "privacy_policy": "https://fiavaion.com/products/assist/privacy"
}
