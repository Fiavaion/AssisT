{
  "manifest_version": 3,
  "version": "0.1.1",
  "author": "AssisT Development Team",
  "icons": {
    "16": "public/icons/icon16.png",
    "32": "public/icons/icon32.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.com/*",
        "*://*.moodle.org/*",
        "*://*.moodlecloud.com/*",
        "*://classroom.google.com/*",
        "*://docs.google.com/*"
      ],
      "js": [
        "src/content/content-simple.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "public/icons/icon16.png",
      "32": "public/icons/icon32.png",
      "48": "public/icons/icon48.png",
      "128": "public/icons/icon128.png"
    },
    "default_title": "AssisT - Augmentative Learning"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/components/*.js",
        "src/ui/styles/*.css",
        "public/assets/*",
        "public/icons/*",
        "src/adapters/canvas-adapter.js",
        "src/adapters/moodle-adapter.js",
        "src/adapters/google-classroom-adapter.js",
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "src/pages/discovery/*",
        "src/pages/demo/*",
        "src/pages/help/*",
        "src/utils/*.js"
      ],
      "matches": [
        "*://*.instructure.com/*",
        "*://*.canvas.com/*",
        "*://*.moodle.org/*",
        "*://*.moodlecloud.com/*",
        "*://classroom.google.com/*",
        "*://docs.google.com/*"
      ]
    },
    {
      "resources": [
        "src/ui/styles/*.css",
        "public/icons/*",
        "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
        "assets/*.js",
        "assets/*.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "name": "AssisT: Adaptive Augmentative Tool",
  "description": "Augmentative learning technology that levels the playing field with Text-to-Speech, AI assistance, and powerful adaptive features for all learners",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "contextMenus",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.canvas.com/*",
    "*://*.moodle.org/*",
    "*://*.moodlecloud.com/*",
    "*://classroom.google.com/*",
    "*://docs.google.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "privacy_policy": "https://fiavaion.com/products/assist/privacy"
}
